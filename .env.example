# ─── Core ─────────────────────────────────────────────────────────────
# Postgres connection string. Required.
DATABASE_URL=postgres://isp:isp@localhost:5432/isp
# Long random string used to sign auth tokens. Required. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-string
# Public origin of the site, no trailing slash. Used for canonical URLs, sitemap, OG and CSRF.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Secret shared by the CMS and the preview route. Generate with: openssl rand -hex 16
PREVIEW_SECRET=replace-with-a-random-string

# ─── First administrator (used only by `npm run seed`) ────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-on-first-login

# ─── Email (optional) ────────────────────────────────────────────────
# When SMTP_HOST is set, enquiry notifications and password-reset emails are sent.
# When unset, enquiries are still stored in the CMS; emails are written to the server log only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=website@isp.edu.my
EMAIL_FROM_NAME="ISP Website"
# Inbox that receives new enquiry notifications.
ENQUIRY_NOTIFY_TO=admissions@isp.edu.my

# ─── Enquiry forwarding (optional) ───────────────────────────────────
# If set, each stored enquiry is POSTed as JSON to this URL (admissions CRM, Zapier, etc.).
ENQUIRY_WEBHOOK_URL=
# Sent as `Authorization: Bearer <token>` with the webhook.
ENQUIRY_WEBHOOK_TOKEN=

# ─── Media storage (optional) ────────────────────────────────────────
# When S3_BUCKET is set, uploads go to S3-compatible storage instead of the local ./media folder.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Analytics (optional, consent-gated) ──────────────────────────────
# Google Analytics 4 measurement ID. Loaded only after a visitor accepts analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
