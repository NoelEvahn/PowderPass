# ─── Required ──────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, RDS, or the docker-compose database).
DATABASE_URL=postgres://user:password@host:5432/labeltrunc
# Long random string used to sign sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# The public address of the site, without a trailing slash (read at runtime).
SERVER_URL=https://www.example.com

# ─── Development only ──────────────────────────────────────────────────────
# Sync the database schema automatically while developing (never in production).
# PAYLOAD_DB_PUSH=true

# ─── Online payments: Billplz (FPX banks, cards, Touch 'n Go, other e-wallets) ─
# Leave empty to offer only "reserve and pay at the boutique".
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
# true while testing with a Billplz sandbox account (billplz-sandbox.com)
BILLPLZ_SANDBOX=false

# ─── Email (order confirmations, password resets, staff alerts) ────────────
# Without SMTP, emails are only written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=orders@example.com
EMAIL_FROM_NAME=Label Trunc

# ─── Photo storage ─────────────────────────────────────────────────────────
# Default: photos are saved on the server's disk in MEDIA_DIR (needs a persistent volume).
# MEDIA_DIR=media
# For S3-compatible storage (AWS S3, Cloudflare R2, Backblaze, MinIO) fill these in:
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ─── Scheduled task ────────────────────────────────────────────────────────
# Secret for /tasks/release-holds (call it every 5–15 minutes). openssl rand -hex 24
CRON_SECRET=

# ─── First administrator (used once by `pnpm seed`) ────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
